@startuml Automatic rebase CI/CD Workflows for QubesOS packages - TrenchBoot/grub

skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam defaultFontName Monospace
skinparam defaultFontSize 12

skinparam package {
  BackgroundColor #EEF2FF
  BorderColor #4455AA
  FontStyle bold
}

skinparam component {
  BackgroundColor #DDEEFF
  BorderColor #2255AA
}

skinparam database {
  BackgroundColor #FFF3CD
  BorderColor #BB8800
}

skinparam cloud {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

title Automatic rebase CI/CD Workflows for QubesOS packages - TrenchBoot/grub

' ─────────────────────────────────────
' SHARED WORKFLOWS (.github repository)
' ─────────────────────────────────────
package "TrenchBoot/.github  (shared reusable workflows)" as shared {
  component "rebase.yml\n[workflow_call]\n@master" as rebase_wf
  component "qubes-dom0-packagev2.yml\n[workflow_call]\n@master" as pkg_wf
  component "trigger-woodpecker-pipeline.yml\n[workflow_call]\n@master" as trigger_wf
}

' ─────────────────────────────────────
' GRUB repository
' ─────────────────────────────────────
package "grub" as grub_repo {
  component "rebase-build-and-publish-rebased.yml\n[triggers: workflow_dispatch after\nrebase conflict resolution,\nschedule: Sat 00:00 UTC]" as grub_main

  component "prep-rebase (prepares a branch\n with QubesOS patches)" as grub_j1
  component "try-rebase (tries to rebase TrenchBoot\npatches on top of the QubesOS patches)" as grub_j2
  component "cleanup-after-rebase" as grub_j3
  component "get-version" as grub_j4
  component "qubes-dom0-package (builds QubesOS\nRPMs with TrenchBoot patches)" as grub_j5
  component "trigger-gitea-cicd" as grub_j6

  grub_main --> grub_j1
  grub_j1 --> grub_j2 : needs
  grub_j2 --> grub_j3 : needs
  grub_j2 --> grub_j4 : needs
  grub_j4 --> grub_j5 : needs
  grub_j5 --> grub_j6 : needs
}

' ─────────────────────────────────────
' TRENCHBOOT-RELEASE-CICD-PIPELINE (Woodpecker)
' ─────────────────────────────────────
package "trenchboot-release-cicd-pipeline  (Woodpecker CI)" as wp_repo {
  component "sign-and-publish-test-rpms.yml\n[trigger: manual via API]\nInputs: GITHUB_REPO=grub,\nGITHUB_SHA, GITHUB_RUN_ID,\nQUBES_COMPONENT=grub2,\nWORKFLOW=sign-and-publish-test-rpms" as wp_pipeline

  component "download-rpms\n(from GitHub Actions artifacts)" as wp_s1
  component "sign-rpms\n(GPG sign)" as wp_s2
  component "deploy-rpms\n(upload to FTP)" as wp_s3
  component "cleanup" as wp_s4

  wp_s1 --> wp_s2
  wp_s2 --> wp_s3
  wp_s3 --> wp_s4
}

' ─────────────────────────────────────
' EXTERNAL SYSTEMS
' ─────────────────────────────────────
cloud "GitHub Actions\nArtifact Storage" as gh_artifacts
database "FTP Server\nhttp://dl.3mdeb.com/\nQubesOS/r4.2/current-testing/dom0/fc37" as ftp_server
cloud "Woodpecker CI\n(ci.3mdeb.com)" as woodpecker_ci
cloud "QubesOS/qubes-grub2\n(upstream)" as upstream_grub

' ─────────────────────────────────────
' CROSS-REPO CALLS: grub → shared
' ─────────────────────────────────────
grub_j1 ..> upstream_grub : fetches patches from
grub_j2 ..> rebase_wf : uses (workflow_call)
grub_j5 ..> pkg_wf : uses (workflow_call)
grub_j6 ..> trigger_wf : uses (workflow_call)

' ─────────────────────────────────────
' TRIGGER: GitHub Actions → Woodpecker
' ─────────────────────────────────────
pkg_wf --> gh_artifacts : uploads RPM artifacts
trigger_wf --> woodpecker_ci : HTTP trigger\n(woodpecker-trigger.sh)
woodpecker_ci --> wp_pipeline : dispatches\nsign-and-publish-test-rpms

' ─────────────────────────────────────
' WOODPECKER PIPELINE → external
' ─────────────────────────────────────
wp_s1 ..> gh_artifacts : downloads RPMs\n(GitHub API)
wp_s3 --> ftp_server : deploys signed RPMs\n+ updates repo metadata

' ─────────────────────────────────────
' LEGEND
' ─────────────────────────────────────
legend right
  |= Symbol |= Meaning |
  | A --> B | Sequential job dependency (needs:) |
  | A ..> B | Cross-repo workflow call / API call |
  | [workflow_call] | Reusable workflow invoked by caller |
endlegend

@enduml
